# XHS Auto Publisher - environment example
# Prefer configuring API keys in the app Settings page. They are saved encrypted in ~/.xhs-publisher/keys.enc.

XHS_COOKIE=
XHS_PROXY=
XHS_PUBLISH_INTERVAL_SECONDS=300
XHS_MAX_DAILY_POSTS=10
XHS_LOG_LEVEL=INFO
XHS_NOTIFICATION_WEBHOOK_URL=

# Optional fallback only. Do not commit real keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.xiaomimimo.com/v1
OPENAI_MODEL=mimo-v2.5
KIMI_API_KEY=
NVIDIA_API_KEY=
XHS_DEFAULT_PROVIDER=openai
