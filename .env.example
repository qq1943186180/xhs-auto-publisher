# 小红书自动发布系统 - 环境变量示例
# 复制为 .env 后填写真实配置；不要把 .env 提交到 GitHub。

# 小红书 Cookie，可选。更推荐使用浏览器登录态。
XHS_COOKIE=

# 代理地址，可选。
XHS_PROXY=

# 发布间隔，单位：秒。
XHS_PUBLISH_INTERVAL_SECONDS=300

# 每日最大发布数量。
XHS_MAX_DAILY_POSTS=10

# 日志级别：DEBUG / INFO / WARNING / ERROR
XHS_LOG_LEVEL=INFO

# 通知 Webhook，可选。
XHS_NOTIFICATION_WEBHOOK_URL=

# 大模型 API Key，可选。也可以在应用设置页里配置。
OPENAI_API_KEY=
KIMI_API_KEY=
